# Copy this file to .env and replace the values.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=greencampus_app
MYSQL_PASSWORD=change_this_password
MYSQL_DATABASE=greencampus_db

# Comma-separated origins. Add the actual frontend origin if serving it with a local web server.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24
